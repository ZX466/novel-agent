# ============================================================
# Project11 — Root .env.example
# Copy backend/.env.example -> backend/.env and fill in real values.
# Copy frontend/.env.example -> frontend/.env.local.
# NEVER commit real .env files.
# ============================================================

# --- DeepSeek (draft stage) ---
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Default: deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Qwen / DashScope (refine stage) ---
# Get from: https://dashscope.aliyuncs.com/
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max

# --- Claude via relay (evaluate stage) ---
RELAY_API_KEY=sk-your-relay-key
RELAY_API_BASE=https://your-relay.example.com/v1
RELAY_CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Embedding (RAG memory layer) ---
# Used for vectorizing chapters, characters, world settings, plot events.
# Separate from the chat BYOK stages — this is server-side only.
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project11

# --- Redis ---
REDIS_URL=redis://:project11-redis@localhost:16379/0

# --- CORS ---
CORS_ORIGINS=["http://localhost:7421"]

# --- Pipeline tuning ---
PIPELINE_SCORE_THRESHOLD=0.8
PIPELINE_MAX_ITERS=3

# Multi-dimensional evaluation (6 dimensions in parallel)
PIPELINE_MULTI_DIM_EVAL=true

# Max concurrent LLM calls during evaluation (1 for low-rate-limit providers)
PIPELINE_EVAL_CONCURRENCY=1

# --- BYOK controls ---
# When true, fall back to .env credentials if no X-Provider-Config header
BYOK_FALLBACK_TO_ENV=true
# Allow localhost api_base (for local dev only, disable in production)
BYOK_ALLOW_LOCAL_API_BASE=false
