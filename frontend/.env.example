# Frontend env vars. Copy to .env.local and fill in.
# Next.js only exposes vars prefixed with NEXT_PUBLIC_ to the browser.

# Backend URL — FastAPI direct. No BFF.
# Local dev:  http://localhost:8000
# Server:     https://your-domain.com  (nginx routes /v1/chat to backend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
