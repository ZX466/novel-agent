# =============================================================================
# LOCAL docker-compose.local.yml 所需密钥（复制为 .env 后填入）
# Copy-Item .env.example .env  （.env 不入库）
# 密码要求：>=20 字符随机（PG 与 Redis 各自独立）
# 生成示例（PowerShell）：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 24 | % {[char]$_})
# =============================================================================
POSTGRES_PASSWORD=change-me-please-20-chars-random
REDIS_PASSWORD=change-me-please-20-chars-random
# 可选覆盖：
# POSTGRES_USER=postgres
# POSTGRES_DB=project11
