# Backend env vars. Copy to .env and fill in real values.
# All LLM env vars MUST be set before process start (litellm reads them at import).

# --- DeepSeek (draft stage) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Qwen / DashScope (refine stage) ---
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max

# --- Claude via relay (evaluate stage) ---
# Most domestic relays speak OpenAI-compatible protocol -> use openai/ prefix in code.
RELAY_API_KEY=sk-your-relay-key
RELAY_API_BASE=https://your-relay.example.com/v1
RELAY_CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Embedding (RAG memory layer) ---
# Embeddings use their OWN credentials, separate from the BYOK chat stages —
# never reuse a chat StageConfig for embeddings (chat endpoints expose no
# /embeddings route and return 404).
# Default below targets DashScope's OpenAI-compatible endpoint + v4.
# EMBEDDING_DIM MUST match the pgvector vector(N) columns (1536) and the
# EMBEDDING_DIM constants in app/models/*.py. text-embedding-v4 defaults to
# 1024; app/llm/embedding.py pins dimensions=EMBEDDING_DIM so output matches.
EMBEDDING_API_KEY=sk-your-dashscope-key
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1536

# --- BYOK controls ---
# Fall back to .env credentials when request has no X-Provider-Config header.
BYOK_FALLBACK_TO_ENV=true
# Allow api_base pointing to localhost (disable in production).
BYOK_ALLOW_LOCAL_API_BASE=false

# --- PostgreSQL 16 + pgvector ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project11

# --- Redis ---
# Password is required (set via REDIS_PASSWORD on the server, default: project11-redis).
# Format: redis://:PASSWORD@HOST:PORT/DB
REDIS_URL=redis://:project11-redis@localhost:16379/0

# --- CORS (JSON array of allowed origins) ---
CORS_ORIGINS=["http://localhost:7421"]

# --- Pipeline tuning ---
PIPELINE_SCORE_THRESHOLD=0.8
PIPELINE_MAX_ITERS=3

# Multi-dimensional evaluation (6 dimensions: coherence, character_consistency,
# prose_quality, plot_logic, world_consistency, cross_chapter_consistency)
PIPELINE_MULTI_DIM_EVAL=true

# Max concurrent LLM calls during multi-dimensional evaluation.
# Set to 1 for low-rate-limit providers (e.g. mimo-v2.5), raise for relays.
PIPELINE_EVAL_CONCURRENCY=1
# JSON allowlist for X-API-Key. Required to serve protected API
# routes; keys also establish document ownership scope.
API_KEYS=[]
